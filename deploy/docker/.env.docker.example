# Docker Compose env example — AI Landing Factory
# Copy to deploy/docker/.env on server: sudo cp .env.docker.example .env && sudo chmod 600 .env
# Never commit real keys.

PRODUCT_MODE=simple
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false

# Include browser origins that hit nginx (SSH tunnel, domain, loopback)
BACKEND_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://YOUR_DOMAIN,https://YOUR_DOMAIN

PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=
PII_REPORT_TTL_HOURS=72

OCR_ENABLED=false
VLM_ENABLED=false

# Browser/client (relative via nginx) — baked into Next.js client bundle at build
NEXT_PUBLIC_API_URL=/api/v1

# Next.js SSR inside Docker network (absolute — Node cannot fetch relative URLs)
INTERNAL_API_URL=http://backend:8001/api/v1

# Loopback health checks:
# backend: http://127.0.0.1:18001/health
# frontend: http://127.0.0.1:13000/

# Optional: override WOW bundle assets dir inside backend container
# BACKEND_WOW_ASSETS_DIR=/app/frontend/dist-wow/assets
