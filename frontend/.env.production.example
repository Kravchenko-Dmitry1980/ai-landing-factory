# AI Landing Factory — frontend production example
# NEXT_PUBLIC_* is embedded in the client bundle (no secrets).
# INTERNAL_API_URL is server/SSR only (Node) — absolute URL required.

# Browser via nginx reverse proxy (relative is OK in the browser):
NEXT_PUBLIC_API_URL=/api/v1

# Next.js server-side fetch inside Docker network:
INTERNAL_API_URL=http://backend:8001/api/v1
