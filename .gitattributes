# Files that run on the Linux server keep LF line endings even when checked out on Windows:
# a CRLF shell script fails there with "$'\r': command not found".
*.sh text eol=lf
*.conf text eol=lf
*.inc text eol=lf
*.service text eol=lf
*Dockerfile text eol=lf
*.Dockerfile text eol=lf
deploy/docker/docker-compose.yml text eol=lf
deploy/docker/.env.docker.example text eol=lf

# Not part of the product: stays out of the release archive (git archive).
hallmark export-ignore
