# Docker Compose local preview example (experimental)
# Copy to deploy/docker/.env and fill locally. Never commit real keys.

PRODUCT_MODE=simple
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=
PII_REPORT_TTL_HOURS=72

OCR_ENABLED=false
VLM_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
