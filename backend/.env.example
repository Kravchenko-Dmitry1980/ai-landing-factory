# Product mode (Stage P.1): simple | advanced | research
PRODUCT_MODE=simple
ADVANCED_VISUAL_PIPELINE=false
ENABLE_ADVANCED_DIAGNOSTICS=false
CHECK_ADVANCED=false

# LLM Contract Builder
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Semantic generation (Stage E)
SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false

# Domain intelligence (Stage G)
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false
DOMAIN_MIN_CONFIDENCE=0.45
DOMAIN_GRAPH_MAX_ENTITIES=120
DOMAIN_GRAPH_MAX_RELATIONS=240

# CORS (comma-separated; dev default in config.py covers localhost:3000-3010)
# Override only for production or custom setups:
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional limits
# LLM_MAX_CHARS_PER_FILE=3000
# LLM_MAX_TOTAL_CHARS=12000

# PII / Privacy (Stage C.5)
# local_only | hybrid_safe | cloud_unsafe_dev
PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
ENABLE_REHYDRATION=true
PII_MASK_NAMES=true
PII_MASK_EMAILS=true
PII_MASK_PHONES=true

# PII hardening (Stage C.6)
PII_REPORT_TTL_HOURS=72
PII_CLEANUP_ENABLED=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=

# --- Advanced OCR/VLM settings (optional; not required for .\run.ps1) ---

# OCR layer (Stage H.8) — disabled by default
OCR_ENABLED=false
OCR_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=tesseract
OCR_DPI=250
OCR_MAX_PAGES=30
OCR_MAX_SLIDES=40
OCR_MIN_TEXT_CHARS=40
OCR_CACHE_ENABLED=true
OCR_CACHE_DIR=backend/data/ocr_cache
OCR_REQUIRE_ENGINE=false
OCR_MODEL_WARMUP_ON_START=false
OCR_TESSERACT_LANG=rus+eng
OCR_EASYOCR_LANGS=ru,en
OCR_EASYOCR_GPU=false
OCR_ENGINE_PRIORITY=tesseract,easyocr,paddleocr

# VLM adapter contract (Stage H.9.2) — disabled by default, stub only
VLM_ENABLED=false
VLM_PROVIDER=stub
VLM_MODEL_NAME=
VLM_MAX_SLIDES=10
VLM_MIN_VISUAL_CONFIDENCE=0.6
VLM_ALLOWED_CONTENT_TYPES=team_slide,architecture_diagram,tech_stack_slide,goals_slide,metrics_slide,roadmap_slide,table_or_matrix,ui_screenshot
VLM_TIMEOUT_SECONDS=60
VLM_STORE_RAW_RESPONSE=false
