# AI Landing Factory — backend production example
# Copy to server: /opt/ai-landing-factory/shared/backend.env (chmod 600)
# Do NOT commit real secrets.

PRODUCT_MODE=simple
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false

# Required on server (replace with real domain / origin)
BACKEND_CORS_ORIGINS=https://your-domain.example

PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=
PII_REPORT_TTL_HOURS=72

OCR_ENABLED=false
VLM_ENABLED=false

ADVANCED_VISUAL_PIPELINE=false
ENABLE_ADVANCED_DIAGNOSTICS=false
CHECK_ADVANCED=false
