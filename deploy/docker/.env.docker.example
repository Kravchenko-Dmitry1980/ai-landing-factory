# Docker Compose env example — AI Landing Factory
# Copy to deploy/docker/.env on server: sudo cp .env.docker.example .env && sudo chmod 600 .env
# Never commit real keys.

PRODUCT_MODE=simple
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false

# Replace YOUR_DOMAIN after nginx is configured (include http + https if TLS added)
BACKEND_CORS_ORIGINS=http://YOUR_DOMAIN,https://YOUR_DOMAIN

PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=
PII_REPORT_TTL_HOURS=72

OCR_ENABLED=false
VLM_ENABLED=false

# Baked into frontend image at build time — use public nginx URL, not loopback
NEXT_PUBLIC_API_URL=http://YOUR_DOMAIN/api/v1

# Loopback reference (health checks only, not for browser):
# backend: http://127.0.0.1:18001/health
# frontend: http://127.0.0.1:13000/
