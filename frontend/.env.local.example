# Backend API base (must include /api/v1). Restart `npm run dev` after changes.
# Browser/client URL (may be absolute in local dev):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1
# Server/SSR URL (Node fetch — must be absolute; same host in local Windows):
INTERNAL_API_URL=http://127.0.0.1:8001/api/v1
