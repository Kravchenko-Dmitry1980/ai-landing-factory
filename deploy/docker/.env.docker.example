# Lend on one server — settings for deploy/docker (docker-compose v1).
# On the server: sudo cp .env.docker.example .env && sudo chmod 600 .env && sudo nano .env
# Never commit the real .env.

# --- docker-compose itself --------------------------------------------------------
# A fixed project name: the network and images never mix with another project whose
# compose file also sits in a folder called "docker".
COMPOSE_PROJECT_NAME=lend
# docker-compose v1 (1.29) asks Docker for API 1.38, Docker 29 refuses anything below 1.44
# ("client version 1.38 is too old"). Compose v2 ignores this line.
COMPOSE_API_VERSION=1.44

# --- Entry point (the gateway container) ---------------------------------------
# http:  plain HTTP on LEND_HTTP_PORT, the gateway owns the port.
# https: certificates in LEND_CERTS_DIR (fullchain.pem, privkey.pem), HTTP only redirects.
# proxy: the server already has a shared proxy (Traefik, nginx) on 80/443. It owns HTTPS and
#        sends Lend's domain to the gateway. Then LEND_BIND=127.0.0.1 and free ports, e.g.
#        LEND_HTTP_PORT=18080, LEND_HTTPS_PORT=18443 (unused, but Docker still binds it).
LEND_GATEWAY=http
LEND_BIND=0.0.0.0
LEND_HTTP_PORT=80
LEND_HTTPS_PORT=443
LEND_CERTS_DIR=./certs

# Backend and frontend on 127.0.0.1, for checks from the server itself. Change them only if
# another project already uses these ports.
LEND_BACKEND_LOCAL_PORT=18001
LEND_FRONTEND_LOCAL_PORT=13000

# The address people open, with the scheme and the port if it is not 80/443.
# Changes from another address are refused (CSRF), so list every address in use.
BACKEND_CORS_ORIGINS=http://YOUR_SERVER_ADDRESS

# --- Behind the server's Traefik (LEND_GATEWAY=proxy) ------------------------------
# Lend's own name, without https:// (put https://<it> into BACKEND_CORS_ORIGINS too).
# Also used by healthcheck.sh to ask the shared proxy for that name (any proxy, not only Traefik).
LEND_DOMAIN=
# With Traefik: uncomment COMPOSE_FILE (docker-compose then also reads the Traefik labels) and
# fill in the rest from the server admin: Traefik's Docker network, entry points, resolver.
#COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
LEND_TRAEFIK_NETWORK=
LEND_TRAEFIK_ENTRYPOINT=websecure
LEND_TRAEFIK_HTTP_ENTRYPOINT=web
LEND_TRAEFIK_CERTRESOLVER=letsencrypt
# Only if the shared proxy does not listen on 80/443 (for healthcheck.sh).
#LEND_PROXY_HTTP_PORT=80
#LEND_PROXY_HTTPS_PORT=443

# --- Accounts -------------------------------------------------------------------
# auto: the session cookie gets "Secure" when the visitor came over HTTPS (to the gateway,
# or to the shared proxy in proxy mode).
# true: always (TLS ends in a proxy that does not send X-Forwarded-Proto).
SESSION_COOKIE_SECURE=auto
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7

# --- Data -----------------------------------------------------------------------
# The Docker volume with accounts, landings and the library. Keep the name between releases.
LEND_DATA_VOLUME=lend_data

# --- Generation: no GPU, no external AI by default --------------------------------
PRODUCT_MODE=simple
LLM_ENABLED=false
LLM_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SEMANTIC_GENERATION_ENABLED=true
SEMANTIC_USE_LLM=false
DOMAIN_INTELLIGENCE_ENABLED=true
DOMAIN_USE_LLM=false

PRIVACY_MODE=hybrid_safe
ENABLE_PII_DETECTION=true
PII_ENCRYPT_REPORTS=false
PII_ENCRYPTION_KEY=
PII_REPORT_TTL_HOURS=72

OCR_ENABLED=false
VLM_ENABLED=false
